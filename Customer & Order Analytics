#In this SQL, I'm querying a database with multiple tables in it to quantify statistics about customer and order data. 

# 1. Number of unique orders placed in January.
SELECT COUNT(distinct orderid)
FROM JanSales
WHERE length(orderid) = 6
AND orderid <> 'Order ID'
;

# 2. Number of unique orders in January that were for an iPhone.
SELECT COUNT(distinct orderid)
FROM JanSales
WHERE length(orderid) = 6
AND orderid <> 'Order ID'
AND Product = 'iPhone'
;

# 3. List of customer account numbers for all the orders that were placed in February.
SELECT distinct customers.acctnum
FROM customers
INNER JOIN FebSales
ON customers.order_ID = FebSales.orderID
WHERE length(orderid) = 6
AND orderid <> 'Order ID'
;

# 4. Cheapest product in January and its price.
SELECT distinct product, price
FROM JanSales
ORDER BY price ASC LIMIT 1
;

# 5. Total revenue for each product sold in January.
SELECT Product
, SUM(quantity)*price as Revenue
FROM BIT_DB.JanSales
WHERE length(orderid) = 6
AND orderid <> 'Order ID'
GROUP BY Product
;

# 6. Find products sold at 48 Lincoln St, Seattle, WA 98101. Identify how many of each were sold and the total revenue.
SELECT Product
, SUM(quantity)
,SUM(quantity)*price as Revenue
FROM BIT_DB.FebSales
WHERE location = '548 Lincoln St, Seattle, WA 98101'
GROUP BY Product
;

# 7. Count of customers who ordered more than 2 products at a time in February. Average amount spent by those customers.
SELECT 
COUNT(distinct customers.acctnum)
, AVG(FebSales.price*FebSales.Quantity)
FROM FebSales
LEFT JOIN customers
ON FebSales.orderID = customers.order_id
WHERE FebSales.Quantity > 2
AND length(orderid) = 6
AND orderid <> 'Order ID'
;

# 8. Retrieves employee IDs that start with '14', have a single character after '14', and ends with '9'.
SELECT employee_ID
FROM employees
WHERE employee_ID LIKE '14_9'
;

# 9. Retrieves order IDs that start with '16', have a single character after ‘16’, followed by '0', and any number of characters in the last position.
SELECT orderID
FROM BIT_DB.MarSales
WHERE orderID LIKE '16_0%'
;

# 10. Identifies how many of each type of headphone were sold in February.
SELECT SUM(Quantity), Product
FROM BIT_DB.FebSales
WHERE Product LIKE '%Headphones%'
AND length(orderid) = 6
AND orderid <> 'Order ID'
GROUP BY Product
;

# 11. Calculates the average amount spent per account in February.
SELECT AVG(quantity*price)
FROM BIT_DB.FebSales Feb
LEFT JOIN BIT_DB.customers cust
ON FEB.orderid=cust.order_id
WHERE length(orderid) = 6
AND orderid <> 'Order ID'
;

#12. Retrieves order IDs from Georgia where the order has an average price greater than $1,000 and from dates beginning with ‘04/1’.
SELECT orderID
FROM BIT_DB.AprSales
WHERE orderdate like '04/01%'
AND location LIKE '%GA%'
AND length(orderID) = 6
AND orderID <> 'Order ID'
GROUP BY orderID
HAVING AVG(price) > 1000
;

#13. Retrieves location and order IDs where the order ID is a 6 digit number that starts with '1943' and ends with '5'.
SELECT location
, orderID
FROM BIT_DB.MaySales
WHERE orderID LIKE '1943_5'
AND length(orderID) = 6
AND orderID <> 'Order ID'
ORDER BY orderID
;

#13. Retrieves the product that brought in the most revenue in January and the revenue it brought in total.
SELECT Product
, SUM(Quantity*Price) as Revenue
FROM BIT_DB.JanSales
GROUP BY Product
ORDER BY Revenue DESC
LIMIT 1
;
